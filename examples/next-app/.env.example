# Copy to .env.local. Never commit .env.local.

# Public key of the Regresso project (pk_…). Safe to expose: it only writes beacons for one project.
NEXT_PUBLIC_REGRESSO_KEY=pk_test_replace_me

# Where beacons go. Development ingest; leave unset in production (default https://ingest.regresso.dev).
# Set it to /api/beacon to use this app's local endpoint, which validates and logs each beacon.
REGRESSO_INGEST_URL=https://ingest-dev.regresso.dev

# Build upload after `next build`. Only set the token where builds run (CI, your hosting provider),
# not in a file anyone can read. Without it the manifest is written to .next/regresso/ and not uploaded.
# REGRESSO_BUILD_TOKEN=sk_test_replace_me
# REGRESSO_API_URL=https://app.regresso.dev   # default; point at a local platform when developing it

# Optional
# REGRESSO_STRICT=1                 # fail the build when the upload fails (default: warn and continue)
# REGRESSO_ENV=production           # override the detected production | preview | development
# NEXT_PUBLIC_REGRESSO_DEBUG=1      # log beacons in production builds too
