{
  "name": "@regresso/protocol",
  "version": "0.1.0",
  "description": "Regresso beacon protocol: types, validator and codec shared by the browser client and the ingest Worker.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RegressoOrg/regresso-sdk.git",
    "directory": "packages/protocol"
  },
  "homepage": "https://github.com/RegressoOrg/regresso-sdk/tree/main/packages/protocol#readme",
  "keywords": [
    "web-vitals",
    "core-web-vitals",
    "rum"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
