{
  "name": "@regresso/browser",
  "version": "0.0.0",
  "description": "Regresso browser client: Core Web Vitals with component attribution, one beacon per page view.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeff-spurlock/regresso-sdk.git",
    "directory": "packages/browser"
  },
  "homepage": "https://github.com/jeff-spurlock/regresso-sdk/tree/main/packages/browser#readme",
  "keywords": [
    "web-vitals",
    "core-web-vitals",
    "rum",
    "performance"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "size": "node scripts/size.mjs"
  },
  "dependencies": {
    "@regresso/protocol": "workspace:^",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
