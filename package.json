{
  "name": "regresso-sdk",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "size": "pnpm --filter @regresso/browser size",
    "spike": "pnpm --filter next-app spike",
    "changeset": "changeset",
    "pack:test": "node scripts/pack-test.mjs",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "node scripts/release.mjs",
    "publish-packages": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.20.5",
    "tsup": "^9.0.0",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
